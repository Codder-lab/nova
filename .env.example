# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5173

MONGODB_URI=

# Security
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Ollama LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Agent Safeguards
MAX_AGENT_STEPS=10
MAX_EXECUTION_TIME_MS=60000
